{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for all app windows",
  "windows": ["main", "nodes", "settings"],
  "permissions": [
    "allow-get-status",
    "allow-start-or-restart",
    "allow-get-config",
    "allow-save-config",
    "allow-list-custom-nodes",
    "allow-pull-node",
    "allow-clone-node",
    "allow-check-node-updates",
    "allow-open-folder",
    "core:default",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "dialog:default"
  ]
}
